{
  "name": "nextjs-template",
  "version": "1.0.0",
  "engines": {
    "node": ">=14.0.0"
  },
  "private": true,
  "standard-version": {
    "scripts": {
      "prebump": "nfqBump"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "template": {
    "version": "1.0.0",
    "name": "nextjs-typescript-template",
    "path": "https://github.com/nfqde/nextjs-typescript-template.git"
  },
  "scripts": {
    "analyze": "cross-env ANALYZE=true FEATURE_ENV=live next build",
    "analyze:browser": "cross-env ANALYZE=true BUNDLE_ANALYZE=browser FEATURE_ENV=live next build",
    "analyze:server": "cross-env ANALYZE=true BUNDLE_ANALYZE=server FEATURE_ENV=live next build",
    "build:live": "cross-env NODE_ENV=production FEATURE_ENV=live next build",
    "build:stage": "cross-env NODE_ENV=production FEATURE_ENV=stage next build",
    "build:test": "cross-env NODE_ENV=production FEATURE_ENV=test next build",
    "check:types": "tsc -p .",
    "deploy": "standard-version && git push --follow-tags origin main",
    "dev": "python -t -m webbrowser http://localhost:3000 && cross-env FEATURE_ENV=stage next dev -H localhost",
    "lint": "eslint ./src --ext='.js, .jsx, .ts, .tsx'",
    "lint:report": "eslint --output-file eslint_report.json --format json --ext='.js, .jsx, .ts, .tsx' ./src",
    "start": "cross-env NODE_ENV=production next start",
    "start:test": "start-server-and-test 'pnpm run start' http://localhost:3000 'pnpm run test'",
    "start:test:merge": "start-server-and-test 'pnpm run start' http://localhost:3000 'pnpm run test:merge'",
    "test:open:cypress:ct": "pnpx cross-env NODE_ENV=test FEATURE_ENV=test pnpx cypress open-ct",
    "test:open:cypress:integration": "pnpx cross-env NODE_ENV=test FEATURE_ENV=test pnpx cypress open",
    "test:cypress:ct": "pnpx cross-env BABEL_ENV=test NODE_ENV=test FEATURE_ENV=test pnpx cypress run-ct",
    "test:cypress:integration": "pnpx cross-env BABEL_ENV=test NODE_ENV=test FEATURE_ENV=test pnpx cypress run",
    "test:merge": "pnpm run test:cypress:integration && pnpm run test:cypress:ct && pnpx nfqReport",
    "test": "pnpm run test:cypress:integration && pnpm run test:cypress:ct",
    "generate:types": "pnpm nfq-generate-types -f \"@app/features\" -j \"@nfq/feature-flags/jsx\" -i \"WithFeature\" -x \"WithoutFeature\" -e stage"
  },
  "dependencies": {
    "@nfq/react-grid": "^2.13.1",
    "core-decorators": "^0.20.0",
    "framer-motion": "^9.0.4",
    "next": "^13.1.6",
    "next-connect": "1.0.0-next.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "styled-components": "^5.3.6",
    "swr": "^2.0.3"
  },
  "devDependencies": {
    "@axe-core/react": "^4.6.0",
    "@babel/core": "^7.20.12",
    "@babel/eslint-parser": "^7.19.1",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.20.13",
    "@babel/plugin-transform-typescript": "7.20.13",
    "@babel/preset-react": "^7.18.6",
    "@babel/preset-typescript": "^7.18.6",
    "@cypress/code-coverage": "^3.10.0",
    "@cypress/react": "^7.0.2",
    "@cypress/webpack-dev-server": "^3.2.3",
    "@next/bundle-analyzer": "^13.1.6",
    "@nfq/eslint-config": "2.2.9",
    "@nfq/eslint-plugin": "^0.6.0",
    "@nfq/feature-flags": "^3.0.0",
    "@nfq/test-reporter": "^1.1.5",
    "@types/node": "18.14.0",
    "@types/react": "18.0.28",
    "@types/react-dom": "18.0.11",
    "@types/styled-components": "^5.1.26",
    "@typescript-eslint/eslint-plugin": "^5.52.0",
    "@typescript-eslint/parser": "^5.52.0",
    "babel-loader": "^9.1.2",
    "babel-plugin-istanbul": "^6.1.1",
    "babel-plugin-styled-components": "^2.0.7",
    "babel-plugin-transform-react-remove-prop-types": "^0.4.24",
    "cross-env": "^7.0.3",
    "cypress": "^12.6.0",
    "cypress-image-snapshot-plugin": "^1.0.0",
    "cypress-real-events": "^1.7.6",
    "duplicate-package-checker-webpack-plugin": "^3.0.0",
    "eslint": "8.34.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-array-func": "^3.1.8",
    "eslint-plugin-better-styled-components": "^1.1.2",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-jsdoc": "^40.0.0",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-no-unsanitized": "^4.0.2",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-perf-standard": "^1.0.3",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-hooks-ssr": "^0.1.5",
    "eslint-plugin-redos": "^4.4.5",
    "eslint-plugin-security": "^1.7.1",
    "eslint-plugin-sort-destructure-keys": "^1.5.0",
    "html-webpack-plugin": "^5.5.0",
    "mocha": "^10.2.0",
    "mochawesome": "^7.1.3",
    "nyc": "^15.1.0",
    "react-is": "^18.2.0",
    "start-server-and-test": "^1.15.4",
    "typescript": "4.9.5",
    "webpack": "5.75.0",
    "webpack-cli": "5.0.1",
    "webpack-dev-server": "4.11.1"
  },
  "resolutions": {
    "axe-core": "4.4.3",
    "@babel/plugin-transform-typescript": "7.19.3"
  }
}