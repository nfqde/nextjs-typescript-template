{
  "compilerOptions": {
    "allowJs": true,
    "baseUrl": "./",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": true,
    "isolatedModules": false,
    "jsx": "preserve",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "node",
    "noImplicitAny": true,
    "paths": {
        "Classes/*": ["./../src/classes/*"],
        "Components/*": ["./../src/components/*"],
        "Configs/*": ["./../src/configs/*"],
        "Fonts/*": ["./../src/assets/fonts/*"],
        "Images/*": ["./../src/assets/images/*"],
        "Modules/*": ["./../src/modules/*"],
        "Server/*": ["./../src/server/*"],
        "Stores/*": ["./../src/stores/*"],
        "Utils/*": ["./../src/utils/*"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": true,
    "declarationDir": "types",
    "declaration": true,
    "emitDeclarationOnly": true,
    "target": "es5",
    "types": ["node", "cypress"],
  },
  "include": ["../cypress.config.ts", "**/*.ts", "**/*.tsx", "./support/index.d.ts"],
  "exclude": ["node_modules", "dist"]
}
